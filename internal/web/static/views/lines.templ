package views

import (
	"github.com/moth13/finance_tracker/internal/web/static/views/components"
	decimal "github.com/shopspring/decimal"
)

type Infos struct {
	Balance      decimal.Decimal
	FinalBalance decimal.Decimal
	Lines        []*components.Line
}

templ Line(infos Infos) {
	<div class="w-full">
		<div class="max-w-5xl mx-auto p-4 space-y-6">
			<div class="flex items-center justify-between gap-4">
				<div class="bg-white rounded-lg p-4 shadow flex flex-col">
					<div class="text-sm text-gray-500">Balance</div>
					if infos.Balance.GreaterThanOrEqual(decimal.Zero) {
						<div class="text-2xl font-semibold text-green-600">{ infos.Balance.String() }€</div>
					} else {
						<div class="text-2xl font-semibold text-red-600">{ infos.Balance.String() }€</div>
					}
					if infos.FinalBalance.GreaterThanOrEqual(decimal.Zero) {
						<div class="text-sm text-green-400">({ infos.FinalBalance.String() }€)</div>
					} else {
						<div class="text-sm text-red-400">({ infos.FinalBalance.String() }€)</div>
					}
				</div>

				<div class="flex-shrink-0">
					<button class="px-4 py-2 bg-indigo-600 text-white rounded-md" hx-get="/views/lines/new" hx-target="#content">New Line</button>
				</div>
			</div>

			<div class="bg-white rounded-lg shadow overflow-auto">
				<table class="min-w-full table-auto">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Pointed</th>
							<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
							<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Title</th>
							<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Value</th>
							<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Category</th>
							<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Account</th>
							<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Month</th>
							<th class="px-6 py-3"></th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-100">
						for _, line := range infos.Lines {
							@components.LineComponent(*line)
						}
					</tbody>
				</table>
			</div>
		</div>
	</div>
}
