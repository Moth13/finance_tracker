package views

import (
	"fmt"
	"github.com/moth13/finance_tracker/internal/web/static/views/components"
)

templ NewLine(line components.Line) {
	<div class="max-w-md mx-auto bg-white rounded-lg shadow p-6">
		<!-- Buttons carry HTMX attributes; keep form simple -->
		<form class="space-y-3">
				<div class="modal-body">
					<div class="mb-4">
						<label class="block text-gray-700">Title</label>
						<input type="text" name="title" class="w-full p-2 border rounded" value={ line.Title } required/>
					</div>
					<div class="mb-4">
						<label class="block text-gray-700">Value (€)</label>
						<input type="number" step="0.01" name="amount" class="w-full p-2 border rounded" value={ line.Amount.String() } required/>
					</div>
					<div class="mb-4">
						<label class="block text-gray-700">Date</label>
						<input type="date" name="due_date" class="w-full p-2 border rounded" value={ line.DueDate.Format("2006-01-02") } required/>
					</div>
					<div class="mb-3 flex items-center gap-3">
						if line.Checked {
							<input type="checkbox" name="checked" class="h-4 w-4 text-indigo-600" checked />
						} else {
							<input type="checkbox" name="checked" class="h-4 w-4 text-indigo-600" />
						}
						<label class="text-sm text-gray-700">Pointed</label>
					</div>
					<div class="mb-4">
						<label class="block text-gray-700">Account</label>
						<input type="text" name="account_name" class="w-full p-2 border rounded" value={ line.Account } required/>
					</div>
					<div class="mb-4">
						<label class="block text-gray-700">Month</label>
						<input type="text" name="month_name" class="w-full p-2 border rounded" value={ line.Month } required/>
					</div>
					<div class="mb-4">
						<label class="block text-gray-700">Category</label>
						<input type="text" name="category_name" class="w-full p-2 border rounded" value={ line.Category } required/>
					</div>
					<div class="mb-3">
						<label class="block text-sm text-gray-700">Description</label>
						<textarea name="description" class="w-full px-3 py-2 border rounded-md text-sm">{ line.Description }</textarea>
					</div>
				</div>
				<div class="flex justify-end gap-3">
					<button type="button" class="px-3 py-1 text-sm bg-gray-100 rounded" hx-get="/views/lines" hx-target="#content">Cancel</button>
					if line.DbID == 0 {
						<button type="submit" class="px-3 py-1 text-sm bg-indigo-600 text-white rounded" hx-post="/views/lines" hx-target="#content">Add</button>
					} else {
						<button type="submit" class="px-3 py-1 text-sm bg-indigo-600 text-white rounded" hx-put={ fmt.Sprintf("/views/lines/%d", line.DbID) } hx-target="#content">Save</button>
					}
				</div>
			</form>
	</div>
}
