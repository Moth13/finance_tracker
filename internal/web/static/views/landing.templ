package views

templ Landing() {
	<div class="max-w-7xl mx-auto px-6 py-12 lg:py-20">
		<div class="grid gap-8 lg:grid-cols-2 items-center">
			<!-- Hero / left -->
			<section class="space-y-6">
				<div class="inline-flex items-center px-3 py-1 rounded-full bg-green-100 text-green-800 text-sm font-medium w-max">Smart finance tracking</div>
				<h1 class="text-4xl sm:text-5xl font-extrabold leading-tight text-gray-900">Finance Tracker
					<span class="text-indigo-600"> keeps every dollar on track.</span>
				</h1>
				<!-- simple illustrative SVG -->
				<svg class="w-48 h-32 mt-4 text-gray-200" viewBox="0 0 200 100" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
					<rect x="2" y="20" width="40" height="60" rx="4" fill="#eef2ff" />
					<rect x="50" y="8" width="35" height="72" rx="4" fill="#e0e7ff" />
					<rect x="95" y="34" width="28" height="46" rx="4" fill="#c7d2fe" />
					<rect x="130" y="0" width="64" height="80" rx="6" fill="#a78bfa" />
				</svg>
				<p class="text-lg text-gray-600">A unified view of your accounts, realtime categories and simple reports that help you decide.</p>
				<ul class="space-y-2 text-gray-700">
					<li class="flex items-start"><span class="text-green-500 mr-3">✓</span>Unified view of all your bank accounts and cards.</li>
					<li class="flex items-start"><span class="text-green-500 mr-3">✓</span>Real-time spending categories and custom budgets.</li>
					<li class="flex items-start"><span class="text-green-500 mr-3">✓</span>Simple reports that turn raw numbers into clear decisions.</li>
				</ul>
				<div class="flex gap-3 mt-6">
					<button class="px-4 py-2 bg-indigo-600 text-white rounded-md shadow hover:bg-indigo-700" hx-get="/demo" hx-target="#login-card" hx-swap="innerHTML">Try interactive demo</button>
					<button class="px-4 py-2 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-50">Watch product tour</button>
				</div>
			</section>

			<!-- Login / right -->
			<aside id="login-card" class="bg-white rounded-lg shadow p-6">
				<!-- server can return fragments that replace this card; messages go here -->
				<div id="login-messages" aria-live="polite" class="mb-3 text-sm text-red-600"></div>
				<div class="mb-4">
					<div class="text-xl font-semibold text-gray-900">Log in to Finance Tracker</div>
					<div class="text-sm text-gray-500">Secure access to your personal finance cockpit.</div>
				</div>
				<!-- server messages -->
				<!-- If you need to display server errors/success, replace these comments with templ bindings -->
				<form hx-post="/views/login" hx-target="#main" hx-swap="innerHTML" class="space-y-4">
					<div>
						<label class="block text-sm font-medium text-gray-700" for="email">Email</label>
						<input class="mt-1 block w-full px-3 py-2 border rounded-md" id="email" name="email" type="email" required autocomplete="email" />
					</div>
					<div>
						<label class="block text-sm font-medium text-gray-700" for="password">Password</label>
						<input class="mt-1 block w-full px-3 py-2 border rounded-md" id="password" name="password" type="password" required autocomplete="current-password" />
					</div>
					<button class="w-full px-4 py-2 bg-indigo-600 text-white rounded-md" type="submit">Sign in</button>
				</form>
				<div class="mt-4 text-xs text-gray-500 flex justify-between">
					<span>New here? <strong>Start free trial</strong></span>
				</div>
			</aside>
		</div>
	</div>
}
